graph Test {
    workSink int

    //Executed when entity is created
    event OnAwake() {

    }

    event OnPlayerJoin(player entity<Player>) {
        var prisonerOutfit List<OutfitID> = {
            // EResCloth.PrisonerHead,
            // EResCloth.PrisonerTop,
            // EResCloth.PrisonerPants,
            // EResCloth.PrisonerShoes,

            EResCloth.JailbirdHead,
